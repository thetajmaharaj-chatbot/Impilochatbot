PORT=3000

# Create your own random phrase and enter the same value in Meta Webhooks.
META_VERIFY_TOKEN=change-me

# Generated by Meta for the Impilo Drilling Facebook Page.
META_PAGE_ACCESS_TOKEN=

# Meta App Secret. Used to verify X-Hub-Signature-256.
META_APP_SECRET=

# Use the Graph API version shown/supported in your Meta app, for example vXX.X.
META_GRAPH_API_VERSION=vXX.X

# Temporary reply while we prove the Facebook connection works.
DEFAULT_REPLY=Thanks for messaging Impilo Drilling. Our chatbot connection is working and we are getting the assistant ready to help with your enquiry.
